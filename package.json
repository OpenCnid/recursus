{
  "name": "recursus-runtime",
  "version": "0.0.0-foundation",
  "description": "A durable, full-access runtime agent assembled on DeepSeek Harness",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "scripts": {
    "build": "pnpm --filter @opencnid/recursus-assembly build",
    "format:check": "node scripts/check-format.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "pnpm --filter @opencnid/recursus-assembly typecheck",
    "test": "pnpm --filter @opencnid/recursus-assembly test",
    "test:integration": "pnpm --filter @opencnid/recursus-assembly test:integration",
    "test:profile-integration": "pnpm --filter @opencnid/recursus-assembly test:profile-integration",
    "assemble:packages": "pnpm --filter @opencnid/recursus-assembly build && node scripts/assemble-packages.mjs",
    "assemble:finalize": "pnpm --filter @opencnid/recursus-assembly build && node scripts/finalize-package-assembly.mjs",
    "profile": "pnpm --filter @opencnid/recursus-assembly build && node scripts/manage-profile.mjs",
    "smoke:assembled": "pnpm --filter @opencnid/recursus-assembly build && node scripts/run-assembled-smoke.mjs",
    "verify": "node scripts/verify.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm verify"
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "typescript": "6.0.3"
  }
}
