{
  "name": "@opencnid/recursus-assembly",
  "version": "0.1.0-dev.0",
  "description": "Provider-neutral component assembly contracts and acquisition for Recursus",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.19 || >=24"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "pnpm run build && node scripts/run-tests.mjs",
    "test:integration": "pnpm run build && node --test tests/real-pinned.integration.test.mjs",
    "test:profile-integration": "pnpm run build && node --test tests/profile-pinned.integration.test.mjs"
  }
}
